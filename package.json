{
  "name": "inventory-pos-app",
  "version": "1.0.0",
  "description": "Offline Android Inventory + POS + Receipt + Dashboard (Expo + SQLite)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:agentation": "esbuild web/agentation.jsx --bundle --minify --format=iife --outfile=web/agentation.bundle.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.1",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.0",
    "lottie-web": "5.13.0",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@types/react": "~18.3.0",
    "agentation": "^3.1.2",
    "esbuild": "^0.28.2",
    "typescript": "~5.3.0"
  },
  "private": true
}
