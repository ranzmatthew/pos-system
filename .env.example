# Copy to .env and fill in from your Supabase project > Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# The anon/publishable key is safe for client apps when Supabase RLS is enabled.
# Never put a service_role key in this file or in the Android app.
# Apply the checked-in Supabase migrations before enabling cross-device sync.
